# --- Telegram ---
TELEGRAM_BOT_TOKEN=

# --- IQ Option OAuth (emailed after the Google form) ---
IQ_API_BASE=https://api.iqoption.com
IQ_CLIENT_ID=459018691019837
IQ_CLIENT_SECRET=
# must match exactly what you registered in the form
IQ_REDIRECT_URI=https://app.zubabot.com/callback.html
IQ_SCOPE=full offline_access
# reference only (IQ Option's platform id for Zubabot); nothing reads it
IQ_PLATFORM_ID=578

# --- Affiliate tag (confirm values with Evgeny / Affstore) ---
# your affiliate ID, sent as ?aff= on the sign-up page
AFF_ID=743768
# sub-ID becomes Zubabot_tg<TelegramID>
AFF_TRACK_PREFIX=Zubabot_
# optional, sent as ?aff_model=
AFF_MODEL=revenue

# --- Security ---
POSTBACK_KEY=
ADMIN_KEY=

# --- Behaviour ---
# 1 = only accounts made with our link (or invite). 0 = testing only
REQUIRE_LINK=1
# unlock amount = CPA qualifying FTD
MIN_DEPOSIT=20
# coins for a first deposit within 24 h of opening the app
WELCOME_BONUS=500
ALLOW_ORIGIN=https://app.zubabot.com
PORT=8080
DB_FILE=zubabot.db

# --- Launch without OAuth ---
# your real Affstore/IQ link; {afftrack} = user's Telegram id
AFF_LINK=https://iqbroker.com/lp/regframe-01-light-nosocials/en/?aff=743768&aff_model=revenue&afftrack={afftrack}

# --- Strategy lab prices ---
TWELVEDATA_KEY=

# ---- AI brain (real replies for the AI traders and support) ----
ANTHROPIC_API_KEY=
# fast model for everyone
AI_MODEL=claude-haiku-5-5
# smarter model for users who deposited $100+
AI_MODEL_PRO=claude-sonnet-5-5
# messages per day before a user has funded
AI_DAILY_FREE=40
# messages per day after funding
AI_DAILY_PAID=300

# ---- Zubabot Pay (our own crypto checkout for coins and tokens) ----
PAY_USDT_TRC20_ADDRESS=
PAY_BTC_ADDRESS=
TRONGRID_KEY=
PAY_MINUTES=30
PAY_BTC_CONFIRMATIONS=1

# ---- Telegram support assistant (same bot as the mini app) ----
SUPPORT_BOT=on
SUPPORT_MODE=polling
PUBLIC_URL=https://api.zubabot.com
SUPPORT_TEAM_CHAT_ID=
SUPPORT_NAME=Emily
APP_URL=https://app.zubabot.com
FOLLOWUPS=on
QUIET_HOURS=22-8
AI_DAILY_TG=60

# ---- Voice call agents (ElevenLabs) — only needed for tools/sync-voice-agents.mjs ----
ELEVENLABS_API_KEY=
VOICE_AGENT_ZARA=agent_3401m4d99vayfbsbt1j8bhy6vhdz
VOICE_AGENT_ACTIVATION=agent_3501m4pfxwr4ek0se73xevf7tqz7

# ---- Invite friends (coins) ----
BOT_USERNAME=zubabot
MINIAPP_NAME=app
# first 24 h after the friend's first $20+ deposit: under $100 = flat, from $100 = per dollar (capped)
REF_WINDOW_H=24
REF_BIG_FROM=100
REF_BASE=200
REF_PER_DOLLAR=5
REF_CAP=2500
REF_FRIEND_BASE=100
REF_FRIEND_PER_DOLLAR=2
REF_FRIEND_CAP=1000
REF_SHARE=0.03
REF_MIN_TRADES=5
REF_MILESTONES=5:1000,15:3000,30:8000

# ---- AI companies (Admin -> AI engine picks which one answers what; add any you want as backup) ----
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
GEMINI_API_KEY=
# starting value; change it in Admin -> AI engine
AI_DAILY_BUDGET_USD=25

# ---- Voice calls (hold to talk). Pick providers in Admin -> AI engine & voice ----
VOICE=on
# our own GPU voice server(s), e.g. http://1.2.3.4:8090 (see voice-server/README.md)
VOICE_SERVER_URL=
# same long password as in voice-server/.env
VOICE_SERVER_KEY=
DEEPGRAM_API_KEY=
GOOGLE_TTS_KEY=
VOICE_MAX_CALLS=60
# default: ./voice-cache
VOICE_CACHE_DIR=

# ---- Team alerts by email (optional; Telegram alerts need nothing) ----
RESEND_API_KEY=
# or Brevo instead of Resend
BREVO_API_KEY=
# where owner alert emails go
OWNER_EMAIL=
ALERT_FROM=Zubabot alerts <alerts@zubabot.com>

# ---- Sales engine (tune it in Admin -> Sales engine) ----
SALES=on
SALES_MAX_PER_DAY=2
# MAX members text the lead mentor from the Chats tab
MENTOR_CHAT_FROM=2000

# ---- Signals from outside (TradingView alerts, another provider). POST /api/signals/webhook?key=... ----
SIGNAL_WEBHOOK_KEY=

# ---- Optional. Everything below has a good default and can be changed later in Admin. Leave empty if unsure. ----
# daily lives (Admin -> Lives): link people join, times in WAT, the lead mentor's name
LIVE_URL=
LIVE_TIMES=10:00,15:00,18:00,22:00
LEAD_MENTOR=Roland
# alert the team for deposits from this amount ($)
ALERT_BIG_DEPOSIT=200
# minutes before an unanswered human chat pings the team again
HUMAN_SLA_MIN=10
# OTC prices from Twelve Data are cached this many seconds (saves your Twelve Data credits)
TD_CACHE_SEC=55
# voice calls with an AI unlock from this deposit ($); premium voice from VOICE_PREMIUM_FROM
VOICE_FROM=100
VOICE_PREMIUM_FROM=1000
# call minutes a day per person / for MAX ($2,000+) / premium-voice minutes a day (then the call goes on in the standard voice)
VOICE_DAY_MIN=60
VOICE_DAY_MIN_MAX=120
VOICE_PREMIUM_DAY_MIN=20
# order to try: self = our own voice server
VOICE_STT=self,openai,deepgram
VOICE_TTS_STANDARD=self,openai
VOICE_TTS_PREMIUM=elevenlabs,self
# AI reads charts from this deposit ($, MAX); others can unlock one AI for coins; voice notes from VOICE_NOTES_FROM (Pro)
CHARTS_FROM=2000
CHART_UNLOCK_COINS=1500
VOICE_NOTES_FROM=1000
# our own AI server (optional, see START-HERE section 10): an OpenAI-style address, e.g. http://10.0.0.5:8000 (vLLM) or http://10.0.0.5:11434 (Ollama)
SELF_AI_URL=
SELF_AI_KEY=
SELF_AI_MODEL=

# ---- Advanced (normally set in Admin, leave empty) ----
# default AI company for every area (anthropic, openai, deepseek, groq, openrouter, gemini, self) and its backup
AI_PROVIDER=
AI_BACKUP_PROVIDER=
AI_BACKUP_MODEL=
AI_MODEL_VOICE=
# milliseconds to wait for an AI reply
AI_TIMEOUT_MS=25000
ELEVEN_VOICE_DEFAULT=
ELEVEN_VOICE_MALE=
ELEVEN_TTS_MODEL=
OPENAI_STT_MODEL=
OPENAI_TTS_MODEL=
# minutes nobody answers a human chat before the assistant helps meanwhile / hours before a quiet human chat goes back to the assistant
HUMAN_AI_BACK_MIN=30
HUMAN_IDLE_BACK_H=12
# minutes before each live that the invite goes out
LIVE_REMIND_MIN=40
# folder with the AI's training files (default ./knowledge)
KNOWLEDGE_DIR=

# ---- Security (Admin -> Security) ----
# a private Telegram group with the main bot in it: every blocked/flagged message is posted there
SECURITY_CHAT_ID=

# ---- Languages ----
# the model that translates new texts (default: Claude Sonnet 5.5)
AI_MODEL_TRANSLATE=
# where the mini app files are (the server writes web/i18n/<lang>.js there); default ../web next to server/
WEB_DIR=

# Market news for the AIs (economic calendar + forex headlines), refreshed in the background. Optional.
# NEWS_ON=0                     switch it off
# NEWS_CALENDAR_URL=https://nfs.faireconomy.media/ff_calendar_thisweek.json
# NEWS_RSS=https://www.fxstreet.com/rss/news   (comma-separated feeds)
# UPLOAD_DIR=                   where pictures users send to support are kept (default: next to the database)
# UPLOADS_PER_DAY=20            support pictures per person per day
# UPLOAD_KEEP_DAYS=30           pictures older than this are deleted automatically
# VOICE_NOTES_PER_DAY=20         voice notes transcribed per person per day
